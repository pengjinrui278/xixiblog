---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

const trips = (await getCollection('trips')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toISOString().slice(0, 10);

// 交给前端的数据：WGS-84 坐标原样输出，GCJ-02 纠偏在浏览器完成
// 注意保持 date 降序（近期在前）——侧栏、地图首视野、首页桌面都依赖这个顺序
const pins = trips.map((t) => ({
  slug: t.id,
  title: t.data.title,
  place: t.data.place ?? '',
  date: fmt(t.data.date),
  coords: t.data.coords,
  photo: t.data.photo ?? '',
  song: t.data.song ?? null,
  excerpt: t.data.excerpt ?? '',
}));
---
<Base title="旅程" current="旅程" bleed="travel">
  <div class="wrap">
    <div style="padding:52px 0 0">
      <div class="eyebrow">Travel Log</div>
      <h1 class="pagetitle">旅程地图</h1>
      <p class="lede">{trips.length} 个地方 · 每一枚 pin 都是一篇当日日志。搜索或点击地图任意处，就能钉下一枚新的。</p>
    </div>

    <div class="map-tools">
      <div class="searchbox" style="margin:0;max-width:340px">
        <span class="si"><Icon name="search" size={14} /></span>
        <input id="placeSearch" type="search" placeholder="搜索地点：如「青岛」「大理古城」…" autocomplete="off" />
      </div>
      <div id="searchResults" class="search-results"></div>
      <button class="btn" id="markModeBtn" type="button"><Icon name="plus" size={14} /> 点击地图标记</button>
      <a class="btn" href="/write/?type=trip"><Icon name="pen" size={14} /> 写一篇旅程</a>
    </div>

    <div class="travel-layout">
      <div id="map" data-pins={JSON.stringify(pins)}>
        <div class="map-fallback">地图加载中……若长时间无响应：① 确认网络能访问 webrd0*.is.autonavi.com（代理软件需直连国内域名）② 浏览器需支持 WebGL。</div>
      </div>
      <div class="jlist" id="jlist">
        {trips.map((t) => (
          <div class="jitem" data-slug={t.id}>
            <div class="jh"><span>{fmt(t.data.date)} · {t.data.place ?? ''}</span>{t.data.song && <span><Icon name="music" size={11} /> {t.data.song.name}</span>}</div>
            <b>{t.data.title}</b>
            <p>{t.data.excerpt ?? ''}</p>
            {t.data.song && (
              <div class="sg bgm-chip" style="cursor:pointer" data-mid={t.data.song.mid} data-name={t.data.song.name} data-artist={t.data.song.artist}>
                <Icon name="music" size={12} /> 那天的歌：{t.data.song.name} — {t.data.song.artist}
              </div>
            )}
          </div>
        ))}
        {!trips.length && (
          <div class="jitem">
            <b>还没有旅程</b>
            <p>点击地图任意处，或搜索一个地点——第一枚 pin 就从那里开始。</p>
          </div>
        )}
      </div>
    </div>

    <!-- 记录表单（搜索选点或点击地图后弹出） -->
    <div class="record-modal" id="recordModal" hidden>
      <div class="record-card">
        <div class="record-head">
          <b><Icon name="plus" size={14} /> 钉下一枚 pin</b>
          <button class="iconbtn" id="closeModal" type="button" aria-label="关闭"><Icon name="x" size={15} /></button>
        </div>
        <div class="record-grid">
          <label>标题 <input id="fTitle" placeholder="西湖环线骑行" /></label>
          <label>地点 <input id="fPlace" placeholder="浙江杭州" /></label>
          <label>日期 <input id="fDate" type="date" /></label>
          <label>坐标 <input id="fCoords" readonly /></label>
          <label class="wide">照片 <input id="fPhoto" type="file" accept="image/*" /> <span class="hint">≤800KB，jpg/png/webp/svg</span></label>
          <label>那天的歌 <input id="fSong" placeholder="晴天 — 周杰伦" /></label>
          <button class="btn" id="songPick" type="button"><Icon name="music" size={13} /> 搜索补全</button>
          <label class="wide">日志 <textarea id="fBody" rows="4" placeholder="何时、何地、做了什么……"></textarea></label>
        </div>
        <div id="songResults" class="search-results"></div>
        <div class="record-actions">
          <button class="btn solid" id="submitTrip" type="button">提交（经 GitHub 自动部署）</button>
          <span class="hint" id="tripHint"></span>
        </div>
        <div id="tripFallback" hidden>
          <p class="hint">未配置 GITHUB_TOKEN，无法直接提交。已为你生成 Markdown——复制后保存为 <code id="tripPath" class="mono"></code>：</p>
          <textarea id="tripMd" rows="10" class="mono" style="width:100%"></textarea>
        </div>
      </div>
    </div>
  </div>

  <script>
    import maplibregl from 'maplibre-gl';
    import 'maplibre-gl/dist/maplibre-gl.css';

    /* 初始化包成函数：模块脚本软切换按 src 去重，重访时由下方 is:inline 脚本调 window.__xixiTravelInit 补跑。
       data-astro-rerun 不能直接加在模块脚本上——会让 Astro 放弃打包，裸 import 内联进 HTML 直接 SyntaxError */
    function travelInit() {
      const __mapEl = document.getElementById('map');
      if (!__mapEl || __mapEl.dataset.inited) return;
      __mapEl.dataset.inited = '1';

    /* ---------- WGS-84 → GCJ-02（火星坐标系），对齐高德瓦片 ---------- */
    const PI = Math.PI;
    const A = 6378245.0, EE = 0.00669342162296594323;
    function tLat(x: number, y: number) {
      let r = -100 + 2 * x + 3 * y + 0.2 * y * y + 0.1 * x * y + 0.2 * Math.sqrt(Math.abs(x));
      r += ((20 * Math.sin(6 * x * PI) + 20 * Math.sin(2 * x * PI)) * 2) / 3;
      r += ((20 * Math.sin(y * PI) + 40 * Math.sin((y / 3) * PI)) * 2) / 3;
      r += ((160 * Math.sin((y / 12) * PI) + 320 * Math.sin((y * PI) / 30)) * 2) / 3;
      return r;
    }
    function tLng(x: number, y: number) {
      let r = 300 + x + 2 * y + 0.1 * x * x + 0.1 * x * y + 0.1 * Math.sqrt(Math.abs(x));
      r += ((20 * Math.sin(6 * x * PI) + 20 * Math.sin(2 * x * PI)) * 2) / 3;
      r += ((20 * Math.sin(x * PI) + 40 * Math.sin((x / 3) * PI)) * 2) / 3;
      r += ((150 * Math.sin((x / 12) * PI) + 300 * Math.sin((x / 30) * PI)) * 2) / 3;
      return r;
    }
    function wgs84ToGcj02(lng: number, lat: number) {
      const dLat = tLat(lng - 105, lat - 35), dLng = tLng(lng - 105, lat - 35);
      const radLat = (lat / 180) * PI;
      let magic = Math.sin(radLat); magic = 1 - EE * magic * magic;
      const sqrtMagic = Math.sqrt(magic);
      const dLatPx = (dLat * 180) / (((A * (1 - EE)) / (magic * sqrtMagic)) * PI);
      const dLngPx = (dLng * 180) / ((A / sqrtMagic) * Math.cos(radLat) * PI);
      return [lng + dLngPx, lat + dLatPx];
    }
    // GCJ-02 → WGS-84（近似反算，打点记录时用）
    function gcj02ToWgs84(lng: number, lat: number) {
      const [gLng, gLat] = wgs84ToGcj02(lng, lat);
      return [lng * 2 - gLng, lat * 2 - gLat];
    }

    /* ---------- 内联 SVG 图标（与 Icon.astro 同套笔画） ---------- */
    const NOTE = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px" aria-hidden="true"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>';
    const PLUS = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>';
    const CHECK = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';

    const el = document.getElementById('map')!;
    let pins: any[] = [];
    try { pins = JSON.parse(el.getAttribute('data-pins') || '[]'); } catch { pins = []; }

    const isDark = () => document.documentElement.getAttribute('data-theme') === 'dark';
    // 修复点：MapLibre 不支持 {1-4} 子域区间写法，必须显式给出 tiles 数组
    const tileSet = (dark: boolean) => dark
      ? ['1', '2', '3', '4'].map(s => `https://webst0${s}.is.autonavi.com/appmaptile?style=6&x={x}&y={y}&z={z}`)
      : ['1', '2', '3', '4'].map(s => `https://webrd0${s}.is.autonavi.com/appmaptile?lang=zh_cn&size=1&scale=1&style=8&x={x}&y={y}&z={z}`);

    const first = pins[0] ? wgs84ToGcj02(pins[0].coords.lng, pins[0].coords.lat) : [104.06, 30.67];

    const map = new maplibregl.Map({
      container: 'map',
      style: {
        version: 8,
        sources: { gaode: { type: 'raster', tiles: tileSet(isDark()), tileSize: 256, attribution: '© 高德地图' } },
        layers: [{ id: 'bg', type: 'raster', source: 'gaode' }],
      },
      center: first as [number, number],
      zoom: 4.2,
    });
    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'bottom-right');

    // 瓦片加载失败提示（常见：代理把国内域名路由到了境外）
    let tileErrors = 0;
    map.on('error', (e: any) => { if (e?.sourceId === 'gaode') tileErrors++; });

    function popupHtml(p: any) {
      const song = p.song
        ? `<div class="sg bgm-chip" data-mid="${p.song.mid}" data-name="${p.song.name}" data-artist="${p.song.artist}">${NOTE} 那天的歌：${p.song.name} — ${p.song.artist}</div>`
        : '';
      const ph = p.photo ? `<div class="ph" style="background-image:url('${p.photo}')"></div>` : '';
      return `<div class="pinpop"><b>${p.place} · ${p.title}</b>${ph}<div class="jd">${p.date}。${p.excerpt}</div>${song}</div>`;
    }

    function selectJitem(slug: string) {
      document.querySelectorAll('.jitem').forEach((j) => j.classList.toggle('sel', j.getAttribute('data-slug') === slug));
    }

    map.on('load', () => {
      if (!pins.length) return;
      const bounds = new maplibregl.LngLatBounds();
      pins.forEach((p) => {
        const [lng, lat] = wgs84ToGcj02(p.coords.lng, p.coords.lat);
        const mk = new maplibregl.Marker({ color: '#B5432C' })
          .setLngLat([lng, lat])
          .setPopup(new maplibregl.Popup({ closeButton: true, maxWidth: '280px' }).setHTML(popupHtml(p)))
          .addTo(map);
        mk.getElement().addEventListener('click', () => selectJitem(p.slug));
        bounds.extend([lng, lat]);
      });
      if (pins.length > 1) map.fitBounds(bounds, { padding: 60, maxZoom: 6 });
      if (tileErrors > 0) console.warn('部分瓦片加载失败，请检查代理是否直连 *.is.autonavi.com');
    });

    /* ---------- 记录表单 ---------- */
    const modal = document.getElementById('recordModal') as HTMLElement;
    let pendingPhoto: { name: string; base64: string } | null = null;

    function openForm(wgsLng: number, wgsLat: number) {
      (document.getElementById('fCoords') as HTMLInputElement).value = `${wgsLng.toFixed(5)}, ${wgsLat.toFixed(5)}`;
      (document.getElementById('fDate') as HTMLInputElement).value = new Date().toISOString().slice(0, 10);
      modal.hidden = false;
    }
    function closeForm() { modal.hidden = true; }
    document.getElementById('closeModal')!.addEventListener('click', closeForm);
    modal.addEventListener('click', (e) => { if (e.target === modal) closeForm(); });

    document.getElementById('markModeBtn')!.addEventListener('click', function () {
      this.classList.toggle('solid');
      map.getCanvas().style.cursor = this.classList.contains('solid') ? 'crosshair' : '';
      this.innerHTML = this.classList.contains('solid') ? `${PLUS} 点击地图任意处…` : `${PLUS} 点击地图标记`;
    });
    map.on('click', (e) => {
      const btn = document.getElementById('markModeBtn')!;
      if (!btn.classList.contains('solid')) return;
      const [wLng, wLat] = gcj02ToWgs84(e.lngLat.lng, e.lngLat.lat);
      btn.classList.remove('solid');
      map.getCanvas().style.cursor = '';
      btn.innerHTML = `${PLUS} 点击地图标记`;
      openForm(wLng, wLat);
    });

    /* ---------- 地点搜索（OpenStreetMap Nominatim，WGS-84 坐标） ---------- */
    const sInput = document.getElementById('placeSearch') as HTMLInputElement;
    const sBox = document.getElementById('searchResults')!;
    let sTimer: number;
    sInput.addEventListener('input', () => {
      clearTimeout(sTimer);
      const q = sInput.value.trim();
      if (!q) { sBox.innerHTML = ''; return; }
      sTimer = setTimeout(async () => {
        try {
          const r = await fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=6&accept-language=zh&q=${encodeURIComponent(q)}`);
          const list = await r.json();
          sBox.innerHTML = list.length
            ? list.map((x: any, i: number) =>
                `<div class="sr-item" data-lng="${x.lon}" data-lat="${x.lat}" data-name="${x.display_name.split(',')[0]}">
                   <b>${x.display_name.split(',')[0]}</b><span>${x.display_name.slice(0, 60)}</span>
                 </div>`).join('')
            : '<div class="sr-item">没有找到——可以直接在地图上手动标记</div>';
          sBox.querySelectorAll<HTMLElement>('.sr-item[data-lng]').forEach((item) => {
            item.addEventListener('click', () => {
              const lng = parseFloat(item.dataset.lng!), lat = parseFloat(item.dataset.lat!);
              const [gLng, gLat] = wgs84ToGcj02(lng, lat);
              map.flyTo({ center: [gLng, gLat], zoom: 9, speed: 1.6 });
              (document.getElementById('fPlace') as HTMLInputElement).value = item.dataset.name ?? '';
              sBox.innerHTML = '';
              openForm(lng, lat);
            });
          });
        } catch {
          sBox.innerHTML = '<div class="sr-item">搜索服务暂时不可达（需要能访问 nominatim.org）</div>';
        }
      }, 350);
    });

    /* ---------- 照片读取 ---------- */
    document.getElementById('fPhoto')!.addEventListener('change', function (this: HTMLInputElement) {
      const file = this.files?.[0];
      pendingPhoto = null;
      if (!file) return;
      if (file.size > 800 * 1024) { (document.getElementById('tripHint')!).textContent = '照片超过 800KB，请压缩后再试'; this.value = ''; return; }
      const reader = new FileReader();
      reader.onload = () => {
        const dataUrl = reader.result as string;
        pendingPhoto = { name: file.name, base64: dataUrl.split(',')[1] };
        (document.getElementById('tripHint')!).textContent = `已读取照片：${file.name}`;
      };
      reader.readAsDataURL(file);
    });

    /* ---------- 歌曲搜索补全 ---------- */
    document.getElementById('songPick')!.addEventListener('click', async () => {
      const q = (document.getElementById('fSong') as HTMLInputElement).value.split('—')[0].trim();
      if (!q) return;
      const box = document.getElementById('songResults')!;
      try {
        const r = await fetch('/api/qqmusic/search?q=' + encodeURIComponent(q));
        const j = await r.json();
        box.innerHTML = (j.list ?? []).slice(0, 5).map((s: any) =>
          `<div class="sr-item" data-mid="${s.mid}" data-name="${s.name}" data-artist="${s.artist}"><b>${s.name}</b><span>${s.artist}</span></div>`).join('');
        box.querySelectorAll<HTMLElement>('.sr-item[data-mid]').forEach((item) => {
          item.addEventListener('click', () => {
            (document.getElementById('fSong') as HTMLInputElement).value = `${item.dataset.name} — ${item.dataset.artist} — ${item.dataset.mid}`;
            box.innerHTML = '';
          });
        });
      } catch { box.innerHTML = '<div class="sr-item">搜索不可用，手填「歌名 — 歌手」即可</div>'; }
    });

    /* ---------- 提交：GitHub API 或降级复制 ---------- */
    // YAML 单引号包裹：空串/冒号/特殊字符都不会再把 frontmatter 弄坏（' 转义为 ''）
    const yq = (s: string) => String(s).replace(/'/g, "''");
    function buildMd(slug: string, photoPath: string | null): string {
      const [lng, lat] = (document.getElementById('fCoords') as HTMLInputElement).value.split(',').map((s: string) => parseFloat(s));
      const [sName, sArtist, sMid] = (document.getElementById('fSong') as HTMLInputElement).value.split('—').map((s: string) => s.trim());
      const title = (document.getElementById('fTitle') as HTMLInputElement).value || '未命名';
      const place = (document.getElementById('fPlace') as HTMLInputElement).value || '';
      const date = (document.getElementById('fDate') as HTMLInputElement).value || new Date().toISOString().slice(0, 10);
      const body = (document.getElementById('fBody') as HTMLTextAreaElement).value;
      return `---
title: '${yq(title)}'
place: '${yq(place)}'
coords: { lng: ${lng.toFixed(5)}, lat: ${lat.toFixed(5)} }
date: ${date}${photoPath ? `\nphoto: ${photoPath}` : ''}${sName ? `
song:
  mid: '${sMid || ''}'
  name: ${sName}${sArtist ? `
  artist: ${sArtist}` : ''}` : ''}
excerpt: '${yq(body.split('\n')[0].slice(0, 60))}'
---

${body}
`;
    }

    document.getElementById('submitTrip')!.addEventListener('click', async () => {
      const hint = document.getElementById('tripHint')!;
      const title = (document.getElementById('fTitle') as HTMLInputElement).value.trim();
      if (!title) { hint.textContent = '先给这篇旅程起个标题吧'; return; }
      const slug = title.toLowerCase().replace(/[^a-z0-9一-龥]+/g, '-').replace(/^-|-$/g, '') || Date.now().toString();
      const files: any[] = [];
      let photoPath: string | null = null;
      if (pendingPhoto) {
        const ext = pendingPhoto.name.split('.').pop()!.toLowerCase();
        photoPath = `/photos/${slug}.${ext}`;
        files.push({ path: `public/photos/${slug}.${ext}`, content: pendingPhoto.base64, encoding: 'base64' });
      }
      const md = buildMd(slug, photoPath);
      files.push({ path: `src/content/trips/${slug}.md`, content: md, encoding: 'utf8' });

      hint.textContent = '提交中……';
      try {
        const r = await fetch('/api/github', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ files, message: `trip: ${title}` }),
        });
        if (r.ok) {
          hint.innerHTML = `${CHECK} 已提交！约 1 分钟后自动上线`;
          setTimeout(() => location.reload(), 2500);
        } else if (r.status === 501) {
          throw new Error('no-token');
        } else {
          const j = await r.json().catch(() => ({}));
          hint.textContent = '提交失败：' + (j.error ?? r.status);
        }
      } catch {
        // 降级：给出 Markdown 自行保存
        (document.getElementById('tripFallback') as HTMLElement).hidden = false;
        (document.getElementById('tripMd') as HTMLTextAreaElement).value = md;
        (document.getElementById('tripPath') as HTMLElement).textContent = `src/content/trips/${slug}.md`;
        hint.textContent = '复制上方 Markdown，放进仓库后 push 即上线';
      }
    });

    // 侧栏日志 → 飞到对应 pin 并弹窗
    document.querySelectorAll('.jitem').forEach((item) => {
      item.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.bgm-chip')) return;
        const slug = item.getAttribute('data-slug');
        const p = pins.find((x) => x.slug === slug);
        if (!p) return;
        const [lng, lat] = wgs84ToGcj02(p.coords.lng, p.coords.lat);
        selectJitem(slug);
        map.flyTo({ center: [lng, lat], zoom: 8, speed: 1.4 });
        setTimeout(() => {
          new maplibregl.Popup().setLngLat([lng, lat]).setHTML(popupHtml(p)).addTo(map);
        }, 900);
      });
    });

    // 日夜切换 → 换高德暗色瓦片（容器被软切换移除后自动断开，避免旧观察者累积）
    const mo = new MutationObserver(() => {
      if (!document.getElementById('map') || !document.body.contains(map.getContainer())) { mo.disconnect(); return; }
      try {
        const src = map.getSource('gaode') as maplibregl.RasterTileSource;
        if (src) src.setTiles(tileSet(isDark()));
      } catch { /* 旧 map 已随页面卸载 */ }
    });
    mo.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    }
    travelInit();
    (window as any).__xixiTravelInit = travelInit;
  </script>
  <!-- 软切换重访旅程页时上方模块脚本被去重跳过，由此补初始化（纯 JS 内联 + rerun，每次必达） -->
  <script is:inline data-astro-rerun>
    if (window.__xixiTravelInit) window.__xixiTravelInit();
  </script>
</Base>
