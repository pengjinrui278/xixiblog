---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE, HERO_LINES } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const trips = (await getCollection('trips'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const movies = (await getCollection('movies'))
  .sort((a, b) => (b.data.watchedDate?.valueOf() ?? 0) - (a.data.watchedDate?.valueOf() ?? 0))
  .slice(0, 2);
const memos = (await getCollection('memos'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const latest = posts[0];
const deskEmpty = !latest && !memos.length && !trips.length && !movies.length;
// 特别的日子 → 交给前端与"今天"比对（MM-DD 每年重复 / YYYY-MM-DD 仅当年）
const dayItems = (await getCollection('days')).map((d) => ({
  title: d.data.title,
  date: d.data.date,
  color: d.data.color ?? '#B5432C',
}));
---
<Base current="首页" bleed="home">
  <div class="wrap">
    <!-- B3 · 杂志大留白头版；大标题 = HERO_LINES 随机一句（consts.ts 里维护句池） -->
    <div class="hero" style="min-height:62vh;display:flex;flex-direction:column;justify-content:center;position:relative">
      <!-- 今日胶囊：当天点亮「今天是 X」，平时显示「距下一个日子还有 N 天」；点它进日历墙 -->
      <a class="day-badge" id="dayBadge" href="/calendar/" data-days={JSON.stringify(dayItems)} hidden>
        <span class="dot" id="dayDot" style="background:var(--seal)"><Icon name="calendar" size={12} /></span>
        <span id="dayText"></span>
      </a>
      <div class="eyebrow">Under the Lamp · 曦曦</div>
      <div class="hi" id="heroLine" style="max-width:640px" set:html={HERO_LINES[0].replace(/\n/g, '<br/>')}></div>
      <p class="sub">{SITE.description}</p>
      <div class="quick">
        <a class="btn solid" href={latest ? `/posts/${latest.id}/` : '/write/?type=post'}>
          {latest ? '读最新一篇' : '写下第一篇'} <span class="ic"><Icon name="pen" size={14} /></span>
        </a>
        <a class="btn" href="/about/">这是谁？</a>
      </div>
      <div style="margin-top:auto;color:var(--ink2);font-size:13px">↓ 桌面上散落着我的最近</div>
    </div>

    <!-- A4 · 散点桌面（首页版）：最新物件散落一桌 -->
    <section class="block">
      <h2>桌面</h2>
      <div class="board-desk" style="height:56vh">
        {latest && (
          <a class="desk-item" href={`/posts/${latest.id}/`} style={`--note:#FDFAF1;--rot:-1.5deg;left:6%;top:12%`}>
            <Icon name="file" size={14} /> 最新长文<br/><b>{latest.data.title}</b>
            <span class="dt">{fmt(latest.data.pubDate)}</span>
          </a>
        )}
        {memos[0] && (
          <a class="desk-item" href="/board/" style={`--note:${memos[0].data.color}33;--rot:2deg;left:52%;top:8%`}>
            <Icon name="pin" size={14} /> {memos[0].data.text}
            <span class="dt">{fmt(memos[0].data.date)}</span>
          </a>
        )}
        {trips[0] && (
          <a class="desk-item photo" href="/travel/" style={`--rot:1.2deg;left:30%;top:44%`}>
            {trips[0].data.photo && <img src={trips[0].data.photo} alt={trips[0].data.place} width="174" />}
            <Icon name="send" size={14} /> {trips[0].data.place} · {trips[0].data.title}
            <span class="dt">{fmt(trips[0].data.date)}</span>
          </a>
        )}
        {movies[0] && (
          <a class="desk-item" href="/movies/" style={`--note:${movies[0].data.color ?? '#8A6A45'}44;--rot:-2.2deg;left:70%;top:40%`}>
            <Icon name="film" size={14} /> 《{movies[0].data.title}》<br/>「{movies[0].data.quote}」
            <span class="dt">{movies[0].data.year} · {movies[0].data.rating} 分</span>
          </a>
        )}
        {deskEmpty && (
          <div class="desk-item" style="--note:#FDFAF1;--rot:-1deg;left:8%;top:14%">
            <Icon name="bulb" size={14} /> 桌面还空着。<br/>
            去 <a href="/write/" style="color:var(--seal);font-weight:700">写作工作室</a> 添第一笔吧。
          </div>
        )}
        <div class="board-add">
          <a class="btn" href="/board/">去灵感墙整理桌面</a>
        </div>
      </div>
    </section>

    <section class="block">
      <h2>工坊台 · 可以上手玩</h2>
      <div class="bench">
        <a class="tool" href="/lab/">
          <div class="tt"><Icon name="bot" size={18} /> 实验室 · 轨道行星</div>
          <div class="td">正在敲打的作品挂在轨道上，它牵出的文章环绕四周。</div>
          <div class="tm"><span class="go">进实验室</span></div>
        </a>
        <a class="tool" href="/travel/">
          <div class="tt"><Icon name="compass" size={18} /> 旅程地图</div>
          <div class="td">搜索、钉下坐标、配上那天的歌。照片和日志钉在同一个点上。</div>
          <div class="tm"><span class="go">去钉一枚 pin</span></div>
        </a>
        <a class="tool" href="/movies/">
          <div class="tt"><Icon name="film" size={18} /> 观影票根墙</div>
          <div class="td">一张票根一部片，只留一句话。票根颜色自己定。</div>
          <div class="tm"><span class="go">去贴一张票根</span></div>
        </a>
      </div>
    </section>
  </div>

  <!-- 每次进入首页：随机换一句标题；右上角亮起"今天是什么日子" -->
  <script define:vars={{ lines: HERO_LINES }}>
    (function () {
      var el = document.getElementById('heroLine');
      if (el && lines.length) {
        var pick = lines[Math.floor(Math.random() * lines.length)];
        el.innerHTML = String(pick).replace(/\n/g, '<br/>');
        el.classList.add('swapped');
      }

      var badge = document.getElementById('dayBadge');
      if (badge) {
        var items = [];
        try { items = JSON.parse(badge.getAttribute('data-days') || '[]'); } catch (e) {}
        var now = new Date();
        var p2 = function (n) { return (n < 10 ? '0' : '') + n; };
        var today0 = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        var mmdd = p2(now.getMonth() + 1) + '-' + p2(now.getDate());
        var ymd = now.getFullYear() + '-' + mmdd;
        // 今天命中的日子（MM-DD 每年重复；YYYY-MM-DD 仅当年）
        var hits = items.filter(function (d) { return d.date === mmdd || d.date === ymd; });
        // 每个日子的下一次出现
        var nextOf = function (d) {
          if (/^\d{4}-/.test(d.date)) {
            var t0 = new Date(d.date + 'T00:00:00');
            return t0 >= today0 ? t0 : null;
          }
          var t = new Date(now.getFullYear() + '-' + d.date + 'T00:00:00');
          if (t < today0) t = new Date((now.getFullYear() + 1) + '-' + d.date + 'T00:00:00');
          return t;
        };
        var upcoming = items
          .map(function (d) { return { d: d, t: nextOf(d) }; })
          .filter(function (x) { return x.t; })
          .sort(function (a, b) { return a.t - b.t; });
        var textEl = document.getElementById('dayText');
        var dot = document.getElementById('dayDot');
        if (hits.length) {
          badge.hidden = false;
          textEl.innerHTML = '今天是 <b>' + hits.map(function (d) { return d.title; }).join(' · ') + '</b>';
          if (dot && hits[0].color) dot.style.background = hits[0].color;
        } else if (upcoming.length) {
          var n = Math.round((upcoming[0].t - today0) / 86400000);
          badge.hidden = false;
          textEl.innerHTML = '距 <b>' + upcoming[0].d.title + '</b> 还有 ' + n + ' 天';
          if (dot && upcoming[0].d.color) dot.style.background = upcoming[0].d.color;
        }
      }
    })();
  </script>
</Base>
